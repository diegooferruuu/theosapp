# ─────────────── Theo’s App · configuración del servidor ───────────────
# Copia este archivo a .env (o ejecuta ./scripts/init-env.sh) y completa los valores.

# Puerto público de Nginx
HTTP_PORT=80
# URL pública de la app (también identifica al remitente de las notificaciones push)
APP_URL=https://theo.example.com
# Pon true cuando la app se sirva por HTTPS
COOKIE_SECURE=false
# Zona horaria para fechas, cron y mensajes
TZ=America/La_Paz

# Base de datos (usa solo letras y números en la contraseña)
POSTGRES_USER=theo
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=theosapp

# Sesiones
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
SESSION_DAYS=30

# Superadmin inicial: se crea solo si no existe ningún superadmin.
# Cambia la contraseña desde "Mi perfil" después del primer acceso.
SUPERADMIN_USERNAME=diego
SUPERADMIN_NAME=Diego
SUPERADMIN_PASSWORD=cambia-esto

# Mascotas que se crean si la base está vacía
DEFAULT_PETS=Theo

# Alertas: hora (0-23) a partir de la cual sale el resumen diario
DAILY_ALERT_HOUR=9
