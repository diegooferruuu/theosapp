// Esquema de base de datos — Theo’s App (Fase 1: Módulo Veterinario + Usuarios)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Usuarios ─────────────────────────────

enum Role {
  SUPERADMIN
  USER
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  username             String    @unique
  passwordHash         String    @map("password_hash")
  role                 Role      @default(USER)
  active               Boolean   @default(true)
  notificationsEnabled Boolean   @default(true) @map("notifications_enabled")
  /// Se incrementa al cambiar contraseña o desactivar el usuario para invalidar sesiones.
  tokenVersion         Int       @default(0) @map("token_version")
  lastLoginAt          DateTime? @map("last_login_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  healthRecords     HealthRecord[]
  treatments        MedicationTreatment[]
  groomingLogs      GroomingLog[]
  vetVisits         VetVisit[]
  pushSubscriptions PushSubscription[]
  dosesGiven        MedicationDose[]
  symptoms          SymptomLog[]
  appointments      VetAppointment[]

  @@map("users")
}

// ───────────────────────────── Mascotas ─────────────────────────────

model Pet {
  id              Int       @id @default(autoincrement())
  name            String
  species         String?
  breed           String?
  birthDate       DateTime? @map("birth_date") @db.Date
  /// Se recalcula a partir del registro de peso más reciente.
  currentWeightKg Float?    @map("current_weight_kg")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  healthRecords HealthRecord[]
  treatments    MedicationTreatment[]
  groomingLogs  GroomingLog[]
  vetVisits     VetVisit[]
  weights       WeightRecord[]
  symptoms      SymptomLog[]
  appointments  VetAppointment[]

  @@map("pets")
}

// ──────────────────── Vacunas y desparasitaciones ────────────────────

enum HealthRecordType {
  VACCINE
  DEWORMING_INTERNAL
  DEWORMING_EXTERNAL
}

model HealthRecord {
  id          Int              @id @default(autoincrement())
  petId       Int              @map("pet_id")
  type        HealthRecordType @map("record_type")
  name        String
  dateGiven   DateTime         @map("date_given") @db.Date
  nextDueDate DateTime?        @map("next_due_date") @db.Date
  notes       String?
  createdById Int?             @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  pet       Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([petId])
  @@index([nextDueDate])
  @@map("health_records")
}

// ──────────────────────── Tratamientos médicos ────────────────────────

enum TreatmentStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum TreatmentType {
  PILL
  CAPSULE
  LIQUID
  ORAL_DROPS
  EAR_DROPS
  EYE_DROPS
  OINTMENT
  INJECTION
  CLEANING
  MEDICATED_BATH
  SUPPLEMENT
  OTHER
}

enum ScheduleType {
  /// Cada X horas desde la primera toma.
  INTERVAL
  /// A horas fijas del día, todos los días o cada N días.
  FIXED_TIMES
  /// Sin horario: cuando haga falta, con un intervalo mínimo.
  AS_NEEDED
}

enum FoodTiming {
  WITH_FOOD
  FASTING
}

model MedicationTreatment {
  id               Int             @id @default(autoincrement())
  petId            Int             @map("pet_id")
  type             TreatmentType   @default(OTHER)
  /// Nombre del medicamento o producto (champú, limpiador…).
  medicineName     String          @map("medicine_name")
  /// Texto legible de la dosis ("½ pastilla de 50 mg · con comida").
  dosage           String
  /// Concentración: "50 mg" por pastilla, "50 mg/ml" en jarabes.
  strength         String?
  /// Cantidad por toma (0.5 pastillas, 2.5 ml, 4 gotas…).
  amount           Float?
  /// Unidad cuando el tipo la deja elegir (gota/tira, ml/UI, "capa fina"…).
  unit             String?
  /// Zona: oído derecho, ambos ojos, pata delantera, oídos (limpieza)…
  site             String?
  foodTiming       FoodTiming?     @map("food_timing")
  /// Indicaciones cortas que se muestran al dar la toma.
  instructions     String?
  scheduleType     ScheduleType    @default(INTERVAL) @map("schedule_type")
  startAt          DateTime        @map("start_date")
  /// null = sin fecha de fin.
  durationDays     Int?            @map("duration_days")
  frequencyHours   Int?            @map("frequency_hours")
  /// Horarios fijos 'HH:MM' (hora local).
  times            String[]        @default([])
  everyDays        Int             @default(1) @map("every_days")
  minIntervalHours Float?          @map("min_interval_hours")
  maxPerDay        Int?            @map("max_per_day")
  /// Stock restante, en la unidad de la dosis (pastillas, ml, gotas, usos).
  stockQuantity    Float?          @map("stock_quantity")
  /// Avisar cuando el stock baje de este valor (por defecto, 3 tomas).
  stockAlertAt     Float?          @map("stock_alert_at")
  status           TreatmentStatus @default(ACTIVE)
  /// Enviar un mensaje de Telegram en el horario de cada toma.
  notifyDoses      Boolean         @default(true) @map("notify_doses")
  notes            String?
  createdById      Int?            @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  pet       Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  doses     MedicationDose[]

  @@index([petId])
  @@index([status])
  @@map("medication_treatments")
}

/// Toma marcada como dada: evita que se le dé dos veces y avisa a los demás.
model MedicationDose {
  id          Int      @id @default(autoincrement())
  treatmentId Int      @map("treatment_id")
  /// Número de toma (1 = primera), según el horario calculado.
  doseNumber  Int      @map("dose_number")
  scheduledAt DateTime @map("scheduled_at")
  givenAt     DateTime @default(now()) @map("given_at")
  givenById   Int?     @map("given_by_id")
  notes       String?

  treatment MedicationTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  givenBy   User?               @relation(fields: [givenById], references: [id], onDelete: SetNull)

  @@unique([treatmentId, doseNumber])
  @@map("medication_doses")
}

// ───────────────────────── Higiene y estética ─────────────────────────

enum GroomingServiceType {
  BATH
  HAIRCUT
  NAIL_TRIM
  DENTAL_CLEANING
}

model GroomingLog {
  id          Int                 @id @default(autoincrement())
  petId       Int                 @map("pet_id")
  serviceType GroomingServiceType @map("service_type")
  dateDone    DateTime            @map("date_done") @db.Date
  nextDueDate DateTime?           @map("next_due_date") @db.Date
  notes       String?
  createdById Int?                @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  pet       Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([petId])
  @@index([nextDueDate])
  @@map("grooming_logs")
}

// ─────────────────────── Historial médico y peso ───────────────────────

model VetVisit {
  id          Int      @id @default(autoincrement())
  petId       Int      @map("pet_id")
  date        DateTime @db.Date
  reason      String
  diagnosis   String?
  vetName     String?  @map("vet_name")
  weightKg    Float?   @map("weight_kg")
  notes       String?
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pet          Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  weightRecord WeightRecord?
  /// Cita de la que salió esta visita (si se agendó antes).
  appointment  VetAppointment?

  @@index([petId])
  @@map("vet_visits")
}

model WeightRecord {
  id         Int      @id @default(autoincrement())
  petId      Int      @map("pet_id")
  date       DateTime @db.Date
  weightKg   Float    @map("weight_kg")
  notes      String?
  /// Si el peso se registró en una visita al veterinario.
  vetVisitId Int?     @unique @map("vet_visit_id")
  createdAt  DateTime @default(now()) @map("created_at")

  pet      Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  vetVisit VetVisit? @relation(fields: [vetVisitId], references: [id], onDelete: Cascade)

  @@index([petId, date])
  @@map("weight_records")
}

// ───────────────────────── Notificaciones ─────────────────────────

/// Registro de alertas enviadas, evita duplicados entre ejecuciones del cron.
model NotificationLog {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  message    String
  recipients Int      @default(0)
  sentAt     DateTime @default(now()) @map("sent_at")

  @@map("notification_logs")
}

/// Suscripción Web Push de un dispositivo (PWA instalada o navegador).
model PushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Ajustes internos de la aplicación (p. ej. claves VAPID generadas).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ───────────────────────── Diario de síntomas ─────────────────────────

enum SymptomCategory {
  VOMIT
  DIARRHEA
  COUGH
  SNEEZING
  LIMPING
  ITCHING
  NO_APPETITE
  LETHARGY
  SKIN
  EYES
  EARS
  BREATHING
  URINE
  OTHER
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

model SymptomLog {
  id          Int             @id @default(autoincrement())
  petId       Int             @map("pet_id")
  category    SymptomCategory
  severity    Severity        @default(MILD)
  occurredAt  DateTime        @map("occurred_at")
  description String?
  createdById Int?            @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  pet       Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  photos    SymptomPhoto[]

  @@index([petId, occurredAt])
  @@map("symptom_logs")
}

/// Foto de un síntoma; el archivo vive en UPLOAD_DIR/symptoms/<filename>.
model SymptomPhoto {
  id        Int      @id @default(autoincrement())
  symptomId Int      @map("symptom_id")
  filename  String   @unique
  mimeType  String   @map("mime_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  symptom SymptomLog @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@index([symptomId])
  @@map("symptom_photos")
}

// ───────────────────────── Citas con el veterinario ─────────────────────────

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model VetAppointment {
  id          Int               @id @default(autoincrement())
  petId       Int               @map("pet_id")
  scheduledAt DateTime          @map("scheduled_at")
  reason      String
  vetName     String?           @map("vet_name")
  location    String?
  /// Preparación: "ir en ayunas", "llevar muestra de heces"…
  notes       String?
  status      AppointmentStatus @default(SCHEDULED)
  /// Visita registrada al terminar la cita.
  visitId     Int?              @unique @map("visit_id")
  createdById Int?              @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  visit     VetVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([petId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("vet_appointments")
}
